# CoFT Project .gitignore
# ========================
# For a comprehensive list of .gitignore templates, see https://github.com/github/gitignore

# --- Python & Environment ---
__pycache__/
*.pyc
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Data Files ---
# Ignore all content in the data/ directory...
data/*
# ...but KEEP any .tar.gz archives for distribution.
!data/*.tar.gz
# Also ignore common data file formats that might appear elsewhere
*.pt
*.pth
*.pkl
*.npy
*.torch
*.xlsx
*.csv
*.tsv
*.h5
*.hdf5

# --- Logs & Generated Directories ---
# Ignore log files and directories generated by experiments/tools
*.log
experiments_logs/
optimization_results_*/
diagnostic_test_*/
colab_*/
quick_*/

# --- Model Checkpoints ---
saved_models/
checkpoints/

# --- Temporary & Backup Files ---
*.tmp
*.backup
*.bak

# --- IDE / Editor specific ---
.cursorignore*.tar.gz
*.tar.gz
data/*.tar.gz
*.tar.gz
