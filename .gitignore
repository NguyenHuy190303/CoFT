# CoFT Project .gitignore
# ====================
__pycache__
# ===== DATA FILES =====
# Ignore extracted data directories but allow compressed archives
data/epilepsy/
data/HAR/
data/sleep/
data/SleepEDF/
experiments_logs/
.pyc
.log
# Allow .tar.gz archives for distribution
!data/*.tar.gz

# Ignore other data formats
*.pt
*.pth  
*.pkl
*.npy
*.torch
*.xlsx
experiments_logs/*/
optimization_results_*/
diagnostic_test_*/
colab_*/
quick_*/
.cursorignore
# Large data files
data/
*.csv
*.tsv
*.h5
*.hdf5

# ===== TEMPORARY FILES =====
*.tmp
*.backup
*.bak
*.log

# ===== MODEL CHECKPOINTS =====
saved_models/
checkpoints/

# Ignore all files in the data directory
data/

# Ignore all files in the experiments_logs directory
experiments_logs/

# ===== ENVIRONMENT =====
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/